# Backend API base URL. Browser sends requests here with the HttpOnly session cookie.
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Gemini key for automatic EN <-> ES translation in the procedure form.
# NEXT_PUBLIC_ values are inlined into the browser bundle at build time, so
# this is demo-only — put it behind a server proxy before going to production.
NEXT_PUBLIC_GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash (matches the backend GEMINI_MODEL).
NEXT_PUBLIC_GEMINI_MODEL=